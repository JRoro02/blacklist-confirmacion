
{
  "version": 8,
  "name": "BLACKLIST Deportivo",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "fondo-blacklist",
      "type": "background",
      "paint": {
        "background-color": "#101114"
      }
    },
    {
      "id": "agua",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#191c22"
      }
    },
    {
      "id": "zonas-verdes",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 8,
      "paint": {
        "fill-color": "#171c19",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "carreteras-secundarias",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["minor", "service", "track", "path"]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#8F1721",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          8, 0.5,
          14, 2,
          18, 5
        ]
      }
    },
    {
      "id": "carreteras-principales",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["primary", "secondary", "tertiary", "trunk"]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#E31825",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          5, 0.8,
          10, 2,
          15, 4,
          19, 9
        ]
      }
    },
    {
      "id": "autopistas",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==", ["get", "class"], "motorway"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FF2635",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          5, 1,
          10, 2.5,
          15, 5,
          19, 10
        ]
      }
    },
    {
      "id": "nombres-carreteras",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          ["get", "name:es"],
          ["get", "name"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          8, 10,
          15, 13,
          18, 16
        ]
      },
      "paint": {
        "text-color": "#FFFFFF",
        "text-halo-color": "#101114",
        "text-halo-width": 2
      }
    },
    {
      "id": "nombres-lugares",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:es"],
          ["get", "name"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          4, 10,
          10, 13,
          14, 17
        ]
      },
      "paint": {
        "text-color": "#F5F5F5",
        "text-halo-color": "#101114",
        "text-halo-width": 2
      }
    }
  ]
}
