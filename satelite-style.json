
{
  "version": 8,
  "name": "BLACKLIST Satélite",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "esri-imagery": {
      "type": "raster",
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "attribution": "Imagery © Esri and its imagery providers"
    },
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "fondo-satelite",
      "type": "background",
      "paint": {
        "background-color": "#101114"
      }
    },
    {
      "id": "imagen-satelital",
      "type": "raster",
      "source": "esri-imagery",
      "paint": {
        "raster-opacity": 1
      }
    },
    {
      "id": "carreteras-satelite",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary"]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#E31825",
        "line-opacity": 0.85,
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          8, 0.5,
          12, 1.5,
          16, 3
        ]
      }
    },
    {
      "id": "nombres-carreteras-satelite",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 8,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          ["get", "name:es"],
          ["get", "name"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          8, 10,
          14, 12,
          18, 15
        ],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#FFFFFF",
        "text-halo-color": "#171717",
        "text-halo-width": 2
      }
    },
    {
      "id": "nombres-lugares-satelite",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:es"],
          ["get", "name"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          4, 10,
          9, 12,
          13, 15,
          16, 18
        ],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#FFFFFF",
        "text-halo-color": "#171717",
        "text-halo-width": 2
      }
    }
  ]
}
