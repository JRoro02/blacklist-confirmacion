
{
  "version": 8,
  "name": "BLACKLIST Satélite",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "esri-imagery": {
      "type": "raster",
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "attribution": "Imagery © Esri and its imagery providers"
    },
    "openmaptiles": {
      "type": "vector",
      "tiles": [
        "https://tiles.openfreemap.org/planet/20260802_080001_pt/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "OpenFreeMap © OpenMapTiles. Data from OpenStreetMap"
    }
  },
  "layers": [
    {
      "id": "fondo-satelite",
      "type": "background",
      "paint": {
        "background-color": "#101114"
      }
    },
    {
      "id": "imagen-satelital",
      "type": "raster",
      "source": "esri-imagery",
      "paint": {
        "raster-opacity": 1
      }
    },
    {
      "id": "carreteras-satelite",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 4,
      "filter": [
        "match",
        ["get", "class"],
        ["motorway", "trunk", "primary", "secondary", "tertiary"],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#E31825",
        "line-opacity": 0.9,
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4, 0.6,
          8, 1,
          12, 2,
          16, 4
        ]
      }
    },
    {
      "id": "nombres-carreteras-satelite",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 8,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          ["get", "name:es"],
          ["get", "name"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 11,
          12, 13,
          16, 16
        ],
        "text-allow-overlap": true
      },
      "paint": {
        "text-color": "#FFFFFF",
        "text-halo-color": "#171717",
        "text-halo-width": 2
      }
    },
    {
      "id": "nombres-lugares-satelite",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 2,
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:es"],
          ["get", "name"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          2, 10,
          6, 12,
          10, 15,
          14, 18
        ],
        "text-allow-overlap": true
      },
      "paint": {
        "text-color": "#FFFFFF",
        "text-halo-color": "#171717",
        "text-halo-width": 2
      }
    }
  ]
}
